{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rust-fmt.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)"
    ],
    "ask": [
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo update *)",
      "Bash(cargo install *)",
      "Bash(rustup *)",
      "Edit(./Cargo.toml)",
      "Edit(./rust-toolchain.toml)",
      "Edit(./.cargo/**)",
      "Edit(./build.rs)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)"
    ],
    "deny": [
      "Bash(cargo publish *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        "./.cargo",
        "./rust-toolchain.toml"
      ]
    }
  }
}